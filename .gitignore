# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env.local
.env.production

# Google Cloud credentials
service-account-key.json

# Downloaded Google Drive images (synced at build time via scripts/sync-images.ts)
# These are regenerated on every build — do not commit them
/public/images/hero-album/
/public/images/gallery/
/public/images/throwback/
/public/images/prenup/
/public/images/dress-code/

# Private config & guest list — injected at build via CI secrets (see deploy.yml).
# Keep your real files locally; they must never be committed.
config/wedding.json
config/guests/bea.json
config/guests/koji.json

# Guest list backups
config/guests.backup.*.json

# Generated invite-code distribution sheet (contains secret codes)
config/guests/invite-codes.csv

# Git history rewrite backups (created during history scrubbing)
history-backup-*.bundle

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
