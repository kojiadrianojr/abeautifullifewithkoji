/public/images/hero-album/
/public/images/gallery/
/public/images/throwback/
/public/images/prenup/
/public/images/dress-code/

# Guest list backups
config/guests.backup.*.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
