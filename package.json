{
  "name": "wedding-website-template",
  "version": "1.0.0",
  "description": "A customizable wedding website template built with Next.js",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "tsx scripts/sync-images.ts && tsx scripts/optimize-images.ts",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "validate-config": "tsx scripts/validate-config.ts",
    "generate-invite-codes": "node scripts/generate-invite-codes.mjs",
    "export": "next build",
    "sync-images": "tsx scripts/sync-images.ts",
    "test-drive": "tsx scripts/test-google-drive.ts",
    "clear-cache": "node scripts/clear-cache.js",
    "optimize-images": "tsx scripts/optimize-images.ts"
  },
  "dependencies": {
    "@chakra-ui/icons": "^2.2.4",
    "@chakra-ui/next-js": "^2.2.0",
    "@chakra-ui/react": "^2.8.2",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "dotenv": "^17.3.1",
    "framer-motion": "^11.15.0",
    "googleapis": "^173.0.0",
    "next": "^15.1.4",
    "react": "^19.0.0",
    "react-countdown": "^2.3.6",
    "react-dom": "^19.0.0",
    "react-icons": "^5.0.1",
    "server-only": "^0.0.1",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^15.1.4",
    "tsx": "^4.23.0",
    "typescript": "^5"
  },
  "overrides": {
    "esbuild": "^0.28.1",
    "postcss": "^8.5.10"
  }
}
